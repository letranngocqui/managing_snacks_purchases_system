        <mxCell id="Qmah7wbX7MzmvWVHwsMu-95" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="Discord (khoá SET)" vertex="1">
